# ============================================
# THOZHAN - Git Ignore
# ============================================

# --------------------
# Secrets / environment
# --------------------
.env
.env.*
!.env.example

backend/.env
backend/.env.*
!backend/.env.example

# --------------------
# Python
# --------------------
venv/
.venv/
backend/venv/
backend/.venv/

__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/

# --------------------
# Node / Next.js
# --------------------
node_modules/
.next/
out/

# --------------------
# Vercel
# --------------------
.vercel/

# --------------------
# Logs
# --------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --------------------
# macOS
# --------------------
.DS_Store
.AppleDouble
.LSOverride

# --------------------
# Editors
# --------------------
.vscode/
.idea/

# --------------------
# Temporary files
# --------------------
*.tmp
*.temp
*.swp
*.swo

# --------------------
# Private keys / certificates
# --------------------
*.pem
*.key
*.p12
*.pfx

# --------------------
# Coverage
# --------------------
coverage/
htmlcov/